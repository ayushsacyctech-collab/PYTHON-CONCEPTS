def primeSum(n):
    ans=0
    for i in range (2,n):
        counter=0
        for j in range(1,i+1):
            if (i%j==0):
                counter+=1
        if (counter==2):
            ans+=i
    return ans

n = int(input("Enter a number: "))
print(primeSum(n))